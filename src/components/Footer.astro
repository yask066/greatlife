---
import { contacts } from '../content/contacts';

const navigationLinks = [
  { label: 'Направления', href: '#directions' },
  { label: 'О центре', href: '#about' },
  { label: 'Вопросы', href: '#faq' },
  { label: 'Контакты', href: '#contacts' },
] as const;
---

<footer class="section container" data-page-block="footer" aria-label="Подвал">
  <p>Прекрасная жизнь</p>
  <nav aria-label="Навигация в подвале">
    <ul>
      {navigationLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <p>
    <a id="contact-phone-footer" data-contact-kind="phone" href={contacts.phoneHref}>
      {contacts.phoneDisplay}
    </a>
  </p>
  <p>
    <a
      id="contact-telegram-footer"
      data-contact-kind="telegram"
      href={contacts.telegramHref}
      target="_blank"
      rel="noopener noreferrer"
    >Написать в Telegram</a>
  </p>
</footer>

<style>
  footer nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  footer nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
  }
</style>
