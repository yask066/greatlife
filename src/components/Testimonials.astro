---
import {
  testimonials,
  testimonialsEmptyState,
} from '../content/trust';

const approvedTestimonials = testimonials.filter(
  (testimonial) => testimonial.approval === 'approved' && testimonial.authorConsent,
);
---

<section id="testimonials" class="section section--sage container" data-page-block="testimonials" aria-labelledby="testimonials-title">
  <h2 id="testimonials-title">Отзывы</h2>

  {
    approvedTestimonials.length > 0 ? (
      <div class="testimonials-list card-grid">
        {approvedTestimonials.map((testimonial) => (
          <article class="card" data-testimonial>
            <blockquote>{testimonial.quote}</blockquote>
            <p>{testimonial.attribution}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>{testimonialsEmptyState}</p>
    )
  }
</section>
