---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Audience from '../components/Audience.astro';
import ChessProgram from '../components/ChessProgram.astro';
import Directions from '../components/Directions.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import MeetingFormat from '../components/MeetingFormat.astro';
import Header from '../components/Header.astro';
import ContactSection from '../components/ContactSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import Professionals from '../components/Professionals.astro';
import Testimonials from '../components/Testimonials.astro';
---

<BaseLayout
  title="Прекрасная жизнь — центр психологии и речи в Минске"
  description="Очные психологические консультации, развитие речи, шахматные занятия для подростков и практики с поющими чашами в Минске"
>
  <Header />

  <Hero />

  <Directions />

  <section data-page-block="services" aria-labelledby="services-title">
    <h2 id="services-title">Услуги активного направления</h2>
    <article aria-labelledby="chess-service-title">
      <h3 id="chess-service-title">
        <a href="#chess-program">Шахматы и мышление</a>
      </h3>
      <p>
        Групповая программа для развития памяти, логического мышления, внимания, навыков планирования
        и принятия решений.
      </p>
    </article>
  </section>

  <ChessProgram />
  <About />
  <Audience />
  <MeetingFormat />

  <Professionals />
  <Testimonials />

  <Faq />

  <ContactSection />
  <FinalCta />
  <Footer />
  <MobileContactBar />
</BaseLayout>
