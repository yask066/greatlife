---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Audience from '../components/Audience.astro';
import ChessProgram from '../components/ChessProgram.astro';
import Directions from '../components/Directions.astro';
import Hero from '../components/Hero.astro';
import MeetingFormat from '../components/MeetingFormat.astro';
import Header from '../components/Header.astro';
---

<BaseLayout
  title="Прекрасная жизнь — центр психологии и речи в Минске"
  description="Очные психологические консультации, развитие речи, шахматные занятия для подростков и практики с поющими чашами в Минске"
>
  <Header />

  <Hero />

  <Directions />

  <ChessProgram />
  <About />
  <Audience />
  <MeetingFormat />

  <section id="professionals" data-page-block="professionals" aria-labelledby="professionals-title">
    <h2 id="professionals-title">Специалисты и квалификация</h2>
    <p>Информация о специалистах готовится к публикации.</p>
  </section>

  <section id="testimonials" data-page-block="testimonials" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title">Отзывы</h2>
    <p>Отзывы готовятся к публикации после согласования.</p>
  </section>

  <section id="faq" data-page-block="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Частые вопросы</h2>
    <p>Ответы на частые вопросы будут добавлены в этот раздел.</p>
  </section>

  <section id="contacts" data-page-block="contacts" aria-labelledby="contacts-title">
    <h2 id="contacts-title">Контакты</h2>
    <p>Контактная информация будет добавлена в этот раздел.</p>
  </section>

  <section data-page-block="final-cta" aria-labelledby="final-cta-title">
    <h2 id="final-cta-title">Записаться на встречу</h2>
    <p>Свяжитесь с центром, чтобы обсудить подходящее направление.</p>
  </section>

  <footer data-page-block="footer" aria-label="Подвал">
    <p>Прекрасная жизнь</p>
  </footer>
</BaseLayout>
