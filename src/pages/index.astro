---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Audience from '../components/Audience.astro';
import ChessProgram from '../components/ChessProgram.astro';
import Directions from '../components/Directions.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import MeetingFormat from '../components/MeetingFormat.astro';
import Header from '../components/Header.astro';
import ContactSection from '../components/ContactSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileContactBar from '../components/MobileContactBar.astro';
import Professionals from '../components/Professionals.astro';
import Testimonials from '../components/Testimonials.astro';
---

<BaseLayout
  title="Прекрасная жизнь — центр психологии и речи в Минске"
  description="Очные психологические консультации, развитие речи, шахматные занятия для подростков и практики с поющими чашами в Минске"
>
  <Header />

  <Hero />

  <Directions />

  <ChessProgram />
  <About />
  <Audience />
  <MeetingFormat />

  <Professionals />
  <Testimonials />

  <Faq />

  <ContactSection />
  <FinalCta />
  <Footer />
  <MobileContactBar />
</BaseLayout>
